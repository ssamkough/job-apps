# ──────────────────────────────────────────────────────────────────────────
# Copy to .env for local development. In production these are set in Vercel
# (Project → Settings → Environment Variables), never committed.
# Placeholders only. Values marked SECRET must never be committed or pasted
# into issues/chats. See DEPLOYMENT.md for where each real value comes from.
# ──────────────────────────────────────────────────────────────────────────

# ── App ───────────────────────────────────────────────────────────────────
# Shown on the privacy/terms pages.
SUPPORT_EMAIL="you@example.com"
# Which header carries the real client IP behind your proxy (rate limiting).
# Vercel and most proxies: x-forwarded-for (the default). Cloudflare:
# cf-connecting-ip. Only use a header your proxy overwrites; clients can forge
# the rest and dodge the per-IP limits.
# CLIENT_IP_HEADER="x-forwarded-for"

# ── Neon Auth (managed Better Auth) ───────────────────────────────────────
# Auth URL: Neon Console → your project → branch → Auth → Configuration
# (Settings → Better Auth → Project Info). It ends in /neondb/auth (or your
# database name). Not secret, but it is branch-specific: a development branch
# and the production branch have different URLs and separate users.
NEON_AUTH_BASE_URL="https://ep-xxxxxxxx.neonauth.us-east-2.aws.neon.tech/neondb/auth"
# SECRET. Signs the session-cache cookie; at least 32 characters. Generate your
# own per environment:  openssl rand -base64 32
NEON_AUTH_COOKIE_SECRET="replace-with-openssl-rand-base64-32-output"

# ── Database (PostgreSQL) ─────────────────────────────────────────────────
# SECRET (contain the password). Local development defaults are below.
# On Neon (Console → Connect, pick the branch, role and database):
#   DATABASE_URL = the POOLED host (contains "-pooler"), with
#                  "&pgbouncer=true&connect_timeout=15" appended
#   DIRECT_URL   = the DIRECT host (no "-pooler"); `prisma migrate` uses it
# Keep sslmode=require; drop channel_binding=require if Neon's string has it.
# Neon Auth keeps its own tables in the same database (schema neon_auth).
DATABASE_URL="postgresql://jobapps:jobapps@localhost:5432/jobapps_dev"
DIRECT_URL="postgresql://jobapps:jobapps@localhost:5432/jobapps_dev"

# ── Resume file storage ───────────────────────────────────────────────────
# "local" writes to disk (fine for local dev). "s3" uses an S3-compatible
# bucket and is REQUIRED on Vercel, whose disk is not persistent.
STORAGE_DRIVER="local"
# UPLOAD_DIR="./data/uploads"          # local driver only

# Production: Neon Object Storage, a PRIVATE bucket named "resumes". The app
# proxies downloads through an authenticated route, so the bucket must never be
# public. Uncomment and fill in (Neon Console → Connect → Storage tab, or
# Settings → Credentials → Create credential with storage:read + storage:write):
# STORAGE_DRIVER="s3"
# S3_ENDPOINT="https://br-xxxxxxxx.storage.c-1.us-east-2.aws.neon.tech"  # the branch's storage endpoint
# S3_REGION="us-east-2"
# S3_FORCE_PATH_STYLE="true"           # required for Neon (custom endpoint)
# S3_BUCKET="resumes"
# S3_ACCESS_KEY_ID=""                  # the credential's token_id (nak_live_...)
# S3_SECRET_ACCESS_KEY=""              # SECRET. Shown once when the credential is created
# S3_KEY_PREFIX=""                     # optional folder inside the bucket

# ── AI cover letters (Ollama, local model, no per-token cost) ─────────────
# OFF unless exactly "true". Leave it unset in production until you have an
# Ollama host the app can reach (see "Later: adding AI" in DEPLOYMENT.md). When
# off, the "Write with AI" button is hidden, /api/cover-letter returns 404 and
# none of the OLLAMA_* settings below matter.
AI_ENABLED="false"
OLLAMA_BASE_URL="http://127.0.0.1:11434"
OLLAMA_MODEL="qwen3.8:27b"
# A local model is slow; generation can take a minute or two.
# OLLAMA_TIMEOUT_MS="240000"
# Context window to request. Higher uses more RAM.
# OLLAMA_NUM_CTX="8192"
# Drafts processed at once / waiting. Extra requests get a "busy" message.
# OLLAMA_MAX_CONCURRENCY="1"
# OLLAMA_MAX_QUEUE="3"
# If Ollama sits behind a tunnel/reverse proxy that requires auth (both SECRET):
# OLLAMA_API_KEY=""                          # sent as "Authorization: Bearer …"
# OLLAMA_EXTRA_HEADERS='{"CF-Access-Client-Id":"…","CF-Access-Client-Secret":"…"}'

# ── Tests only (not read by the app) ──────────────────────────────────────
# TEST_DATABASE_URL overrides the database `npm test` uses (name must end in
# _test). Optional; the default is jobapps_test on localhost.
# TEST_DATABASE_URL="postgresql://jobapps:jobapps@localhost:5432/jobapps_test"
