# ──────────────────────────────────────────────────────────────────────────
# Copy to .env (local) or set in your host's environment settings (production).
# Every service below has a free option; see DEPLOYMENT.md for limits.
# ──────────────────────────────────────────────────────────────────────────

# ── App ───────────────────────────────────────────────────────────────────
# Public URL, used in emailed links. REQUIRED in production. Never derived
# from request headers, so a forged Host header can't poison reset links.
APP_URL="http://localhost:3000"
# Shown on the privacy/terms pages.
SUPPORT_EMAIL="you@example.com"
# Which header carries the real client IP behind your proxy (rate limiting).
# Cloudflare: cf-connecting-ip. Vercel/most proxies: x-forwarded-for (default).
# Only set this to a header your proxy overwrites; clients can forge the rest.
# CLIENT_IP_HEADER="x-forwarded-for"

# ── Database (PostgreSQL) ─────────────────────────────────────────────────
# Local: docker/brew Postgres. Hosted free option: Neon.
# On Neon, DATABASE_URL is the *pooled* host and DIRECT_URL the direct host
# (used for migrations). For a plain Postgres, set both to the same URL.
DATABASE_URL="postgresql://jobapps:jobapps@localhost:5432/jobapps_dev"
DIRECT_URL="postgresql://jobapps:jobapps@localhost:5432/jobapps_dev"

# ── AI cover letters (Ollama, local model, no per-token cost) ─────────────
OLLAMA_BASE_URL="http://127.0.0.1:11434"
OLLAMA_MODEL="qwen3.8:27b"
# A local model is slow; generation can take a minute or two.
# OLLAMA_TIMEOUT_MS="240000"
# Context window to request. Higher uses more RAM.
# OLLAMA_NUM_CTX="8192"
# Drafts processed at once / waiting. Extra requests get a "busy" message.
# OLLAMA_MAX_CONCURRENCY="1"
# OLLAMA_MAX_QUEUE="3"
# If Ollama sits behind a tunnel/reverse proxy that requires auth:
# OLLAMA_API_KEY=""                          # sent as "Authorization: Bearer …"
# OLLAMA_EXTRA_HEADERS='{"CF-Access-Client-Id":"…","CF-Access-Client-Secret":"…"}'

# ── Resume file storage ───────────────────────────────────────────────────
# "local" writes to disk (fine for local dev or a single self-hosted server).
# "s3" uses any S3-compatible bucket (Cloudflare R2, Backblaze B2, MinIO…),
# required on serverless hosts where the disk is wiped between requests.
STORAGE_DRIVER="local"
# UPLOAD_DIR="./data/uploads"
# S3_ENDPOINT="https://<account>.r2.cloudflarestorage.com"
# S3_REGION="auto"
# S3_BUCKET=""
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
# S3_FORCE_PATH_STYLE="false"      # "true" for MinIO
# S3_KEY_PREFIX=""

# ── Email (password reset + verification) via any SMTP provider ───────────
# Leave SMTP_HOST empty in development: emails are printed to the server log.
# In production it is required (the app refuses to start sending without it).
# Provider hosts (confirm in your provider's dashboard):
#   Brevo    smtp-relay.brevo.com : 587   (300/day free, no monthly cap) <- best fit
#   Resend   smtp.resend.com : 587, user "resend", pass = API key (100/day AND 3,000/month)
#   SMTP2GO  mail.smtp2go.com : 2525      (200/day AND 1,000/month; monthly overflow is rejected)
# Limits verified Nov 2026; see DEPLOYMENT.md.
# SMTP_HOST=""
# SMTP_PORT="587"
# SMTP_USER=""
# SMTP_PASS=""
# EMAIL_FROM="Job Tracker <noreply@yourdomain.com>"
# Stop sending a little UNDER your provider's daily cap (resets 00:00 UTC),
# so we refuse cleanly instead of the provider rejecting mail.
# Suggested: Brevo 270, Resend 90, SMTP2GO 30 (its monthly cap is the binding one).
# EMAIL_DAILY_LIMIT="90"
