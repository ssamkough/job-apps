{
  "name": "job-apps",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "pretest": "node scripts/prepare-test-db.mjs",
    "test:watch": "vitest",
