generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Pooled connection used by the app (e.g. Neon's "-pooler" host).
  url       = env("DATABASE_URL")
  // Direct connection used by `prisma migrate`. Same value as DATABASE_URL
  // unless you use a connection pooler.
  directUrl = env("DIRECT_URL")
}

// Slim app-side mirror of a Neon Auth user. Credentials, email, name and
// sessions all live in Neon Auth (the `neon_auth` schema); this table exists so
// Application/Resume rows have something to reference and cascade from.
// `id` IS the Neon Auth user id (a uuid, kept as text). Rows are created lazily
// on a user's first authenticated request (see src/lib/auth.ts). There is
// deliberately no foreign key into `neon_auth.*`: that schema belongs to Neon.
model User {
  id           String        @id
  createdAt    DateTime      @default(now())
  applications Application[]
  resumes      Resume[]
  importJobs   ImportJob[]
}

// Fixed-window counters for rate limiting, kept in Postgres so no Redis is
// needed. See src/lib/rate-limit.ts.
model RateLimit {
  key         String
  windowStart DateTime
  count       Int      @default(0)

  @@id([key, windowStart])
  @@index([windowStart])
}

model Resume {
  id           String        @id @default(cuid())
  userId       String
  // Human label, e.g. "Backend – 2026".
  label        String
  fileName     String
  mimeType     String
  size         Int
  // Relative to the uploads root; never exposed to the client.
  storageKey   String        @unique
  createdAt    DateTime      @default(now())
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  applications Application[]

  @@index([userId])
}

model Application {
  id              String        @id @default(cuid())
  userId          String
  company         String
  jobTitle        String
  jobUrl          String?
  location        String?
  // REMOTE | HYBRID | ONSITE
  workType        String?
  salary          String?
  source          String?
  // See src/lib/constants.ts for allowed values.
  status          String        @default("APPLIED")
  // Date only.
  dateApplied     DateTime?     @db.Date
  jobDescription  String?
  notes           String?
  coverLetter     String?
  contactName     String?
  contactEmail    String?
  resumeId        String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  // Last time the status changed (or was confirmed). The planned reminder
  // feature will key off this.
  statusUpdatedAt DateTime      @default(now())
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  resume          Resume?       @relation(fields: [resumeId], references: [id], onDelete: SetNull)
  events          StatusEvent[]

  @@index([userId, status])
  @@index([userId, dateApplied])
}

model StatusEvent {
  id            String      @id @default(cuid())
  applicationId String
  fromStatus    String?
  toStatus      String
  createdAt     DateTime    @default(now())
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
}

// One "import from a job posting" request. The page or PDF text is never stored
// here: it is read, handed to the extractor and dropped. `fields` holds what
// was found without AI (e.g. JSON-LD), `result` the final merged fields.
model ImportJob {
  id         String    @id @default(cuid())
  userId     String
  // URL | PDF | TEXT
  kind       String
  sourceUrl  String?
  // QUEUED | DONE | FAILED | EXPIRED
  status     String    @default("QUEUED")
  fields     Json?
  result     Json?
  errorCode  String?
  createdAt  DateTime  @default(now())
  finishedAt DateTime?
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, status])
}
